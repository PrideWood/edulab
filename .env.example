# PostgreSQL / Neon. Use a pooled connection URL for serverless deployment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_SSL=require
DATABASE_POOL_MAX=5

# Coze published bot credentials. Choose the API host for your Coze region.
COZE_API_TOKEN=pat_xxx
COZE_BOT_ID=your_published_bot_id
COZE_API_BASE_URL=https://api.coze.com

# Participant link signing. Generate a long random secret and keep it private.
PARTICIPANT_LINK_SECRET=replace_with_a_long_random_secret
ADMIN_SESSION_SECRET=replace_with_another_long_random_secret
SETTINGS_ENCRYPTION_KEY=replace_with_a_separate_long_random_secret
EXPERIMENT_ID=learning-scenario-v1
EDULAB_BASE_URL=http://localhost:3000

# Local development only. Never enable this in production.
ALLOW_UNSIGNED_PARTICIPANTS=false

# Used only while running `npm run admin:create`; do not configure this in Vercel.
EDULAB_ADMIN_PASSWORD=replace_with_a_temporary_strong_password
EDULAB_ADMIN_NAME=实验管理员
