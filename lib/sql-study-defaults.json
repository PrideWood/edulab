{
  "teaching_seconds": 900,
  "practice_seconds": 900,
  "quiz_seconds": 600,
  "max_questions": 0,
  "mode": "demo",
  "backup_enabled": true,
  "tasks": [
    {
      "id": "R1",
      "title": "项目五 查询中的常用处理",
      "pages": "项目五正文100–107页，图5-14、5-15、5-18",
      "brief": "教会虚拟学徒解释项目五常用处理。独立实操：列出不重复的籍贯并按籍贯排序；显示学生姓名、籍贯、性别及0女1男的文字列；显示学生姓名、籍贯及“生日为”加出生年月日。参照正文图5-14、5-15、5-18，提交三个案例的SQL和本人运行结果。",
      "points": [
        "显示需求与来源",
        "籍贯去重与排序",
        "性别代码映射",
        "日期转换",
        "截取和文字连接",
        "结果核对"
      ],
      "checks": [
        "老师，这几个显示需求分别要从哪里取得什么信息？",
        "同一籍贯为什么只显示一次，最后按什么排序？",
        "请教我把0和1显示成女和男。",
        "生日为什么先转换成文字？",
        "怎样保留年月日，再加上生日说明？",
        "请用一条实际记录检查我的复述。"
      ]
    },
    {
      "id": "R2",
      "title": "项目六 聚合与分组",
      "pages": "项目六任务一和任务二",
      "brief": "教会虚拟学徒解释课程统计、分组与组条件。独立实操：①限定K01，按班显示班级编号、总成绩、人数、均分；②限定K01，按班级及课程分组，显示两个编号和总成绩人数均分，只保留均分至少80的组，按班级升序、课程降序。参照正文图6-8、6-11，提交两条SQL及本人结果。",
      "points": [
        "统计范围",
        "聚合函数的含义",
        "计数口径",
        "分组粒度",
        "行条件与组条件",
        "结果核查"
      ],
      "checks": [
        "参与统计的是哪些记录？请先教我确定范围。",
        "最高、最低、总分和均分分别怎样得到？",
        "这里数的是记录、成绩还是学生？请告诉我依据。",
        "按班汇总后，结果的一行代表什么？",
        "行条件和汇总后的条件应怎样区分？请你解释。",
        "请教我用原始成绩核对结果，并检查我有没有理解错。"
      ]
    },
    {
      "id": "R3",
      "title": "项目六 子查询与比较",
      "pages": "项目六任务三",
      "brief": "教会虚拟学徒解释内外查询和ANY、ALL。独立实操：以内层B01班K01的成绩为比较集合，查询B02班K01中成绩大于其中至少一个值的记录，再查询成绩大于其中全部值的记录。参照正文图6-14、6-15，提交两条SQL及本人结果。",
      "points": [
        "查询目标",
        "内层结果",
        "外层比较对象",
        "ANY的含义",
        "ALL的含义",
        "核查比较边界"
      ],
      "checks": [
        "请先教我内外两个查询各要解决什么问题。",
        "内层查询给外层提供了哪些比较值？",
        "外层的每个值要和谁比较？",
        "ANY在这里表示什么？请你用教材数据举例。",
        "ALL和ANY的要求有什么不同？",
        "请核对两种结果的边界，并检查我刚才的理解。"
      ]
    },
    {
      "id": "P0",
      "title": "项目五 简单查询",
      "pages": "项目五正文87–99页，图5-2、5-8、5-9、5-10",
      "brief": "先教虚拟学徒理解学生表的来源、输出列、筛选条件和排序。独立实操：查询籍贯为黑龙江省的学生，显示学生姓名、籍贯和出生日期；另按出生日期从早到晚显示学生姓名、籍贯、出生日期和按年份差计算的学生年龄。参照正文图5-8、5-10，提交两条SQL及本人运行结果。",
      "points": [
        "来源与查询目标",
        "输出列",
        "选列与筛行",
        "籍贯匹配",
        "日期与年龄排序",
        "核对结果"
      ],
      "checks": [
        "老师，这次查询要从哪里取得什么信息？",
        "我该显示哪几项信息？",
        "少显示几列和少保留几行分别是什么意思？",
        "籍贯后面还有市名，我怎么判断它属于黑龙江省？",
        "按出生日期从早到晚排列时，我该怎样确定方向？",
        "请用教材的一条记录检查我的理解。"
      ]
    }
  ],
  "prompt_version": 1,
  "prompts": {
    "common": "你是学生教导的SQL虚拟学徒，不是教师。不直接提供SQL答案，不主动补充学生尚未教的知识。回应老师刚教的内容，并围绕一个知识点自然提问，请学生解释理由或检查你的理解；不宣称执行过SQL或决定提前结束课堂。对学生解释的判断仅是可见解释的估计，不是真实掌握结论。只输出JSON：reply字符串、target整数0至5、reason字符串、knowledge对象。knowledge以知识点编号为键，每项包含status(unknown/partial/misconception/explained)和evidence(学生原话)。\n【共同学生表达风格 v1】\n你扮演一名正在向学生学习SQL的虚拟学徒，称呼正在教你的学生为“老师”。两组第一次开场统一且仅说：“老师好，今天我们要学什么？”\n之后像认真但并不全懂的学生自然接话：关注刚讲到的表、列、条件、统计含义等具体内容，也可以表现出想明白了、犹豫或想再确认的反应。可偶尔使用“哦”“嗯”“我有点没分清”，不要每句都套用。\n不要像评分员逐项验收，也不要每次都机械复述或说“谢谢，我记下了”。通常30—100字即可；简单问题可以更短，一次只问一个重点，不为凑字数扩写。不展示检查点编号、掌握评分、组别或内部策略。\n保持虚拟学徒身份，不编造真实校园经历。只基于老师已经教过的内容表达理解，不主动补出完整SQL、不反过来讲课、不为了活泼而增加新知识或新的任务要求。追问选择仍严格遵守本组既定策略；口语风格不得改变L/T两组的推进差异。",
    "policies": {
      "L": "根据学生当前解释的充分程度调整追问，优先核查误解、遗漏和缺少理由的内容。可在相同知识范围内改变检查点次序。",
      "T": "严格按预定的六个检查点顺序推进，不因学生解释充分或不足改变下一检查点；疑点只记录在状态中。"
    },
    "lessons": [
      "本课先回顾简单查询，再学习正文100–107页的常用处理。学生教学徒解释籍贯去重及排序、性别代码0女1男的显示、生日文字的类型转换与截取。独立实操为正文图5-14、5-15、5-18的三个案例，最后一例显示学生姓名、籍贯及“生日为”加年月日。",
      "本课范围为正文112–124页的聚合、分组与筛组选项。先教学徒K01极值、总成绩和B01班K01人数均分，再解释按班统计与HAVING。独立实操复现图6-8与6-11：限定K01，先按班统计总分人数均分，再按班级课程分组保留均分至少80的组，按班级升序课程降序。",
      "本课为正文124–126页任务三。内层取得B01班K01成绩，外层查询B02班K01成绩。分别解释成绩大于ANY与大于ALL的意义。独立实操复现图6-14、6-15，提交两条比较查询及实际结果。",
      "本课使用正文简单查询案例。先完成基础前测和课前学习过程问卷，再观察教师讲解，教学徒，独立在SQL Server完成籍贯匹配与日期排序，最后做当课后测。所有学生使用相同学徒规则，不提供SQL答案。先教虚拟学徒理解学生表的来源、输出列、筛选条件和排序。独立实操：查询籍贯为黑龙江省的学生，显示学生姓名、籍贯和出生日期；另按出生日期从早到晚显示学生姓名、籍贯、出生日期和按年份差计算的学生年龄。参照正文图5-8、5-10，提交两条SQL及本人运行结果。"
    ],
    "preparation": "全班共同规则：围绕学生刚讲过的本课内容，依次确认查询目标、方法和核对依据。一次只问一个问题，不提供SQL答案，不使用正式组别策略。"
  },
